# Existing production MongoDB. Do not start another MongoDB for this service.
# On Docker Desktop, host.docker.internal can reach a MongoDB published on the host.
MONGODB_URI=mongodb://ifile_manager:change-this-password@host.docker.internal:27018/ifile_manager?authSource=admin

# Generate each independently: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
JWT_SECRET=replace-with-at-least-32-random-characters

# Only used when there are no users in the ifile_manager database.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start

# Host directory on the removable disk. Docker maps <this>/ifile-manager to /data.
REMOVABLE_DISK_PATH=/Volumes/YourRemovableDisk
# Read-only source for the V4Log menu. Override if the volume name changes.
V4_LOG_HOST_PATH=/Volumes/SeagateBackup/AlphaPulse-coin-shadow/V4
APP_PORT=4300
IMAGE_TAG=latest

# Default: home Mac only. For Tailscale direct access, set the home's 100.x address.
PUBLIC_BIND_IP=127.0.0.1

# Keep true in production, where the service is accessed through HTTPS.
COOKIE_SECURE=true
MAX_UPLOAD_MB=500
MAX_UPLOAD_FILES=20

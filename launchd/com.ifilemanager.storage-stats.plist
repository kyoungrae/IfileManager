<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.ifilemanager.storage-stats</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>__IFILE_MANAGER_REPOSITORY__/scripts/update-storage-stats.sh</string>
      <string>__IFILE_MANAGER_REPOSITORY__/.env</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WatchPaths</key>
    <array>
      <string>__IFILE_MANAGER_STORAGE_DIRECTORY__/files</string>
      <string>__IFILE_MANAGER_STORAGE_DIRECTORY__/storage</string>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/ifile-manager-storage-stats.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ifile-manager-storage-stats-error.log</string>
  </dict>
</plist>
